{
  "name": "@heads-or-tails/game-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:localnet": "node --import tsx --test tests/localnet.test.ts --test-timeout=120000",
    "test:unit": "node --import tsx --test tests/unit.test.ts tests/b3.test.ts tests/hts.test.ts tests/generation-compat.test.ts tests/usd-reference.test.ts --test-timeout=60000",
    "test:devnet": "node --import tsx --test tests/devnet.test.ts --test-timeout=600000"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@solana/spl-token": "0.4.12",
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.18.6",
    "chai": "5.2.1",
    "bip39": "3.1.0",
    "ed25519-hd-key": "1.3.0",
    "mocha": "11.7.2",
    "ts-node": "10.9.2",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
